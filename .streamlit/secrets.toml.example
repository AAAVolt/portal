# Copia este fichero a .streamlit/secrets.toml para desarrollo local, y pega el
# mismo contenido en Streamlit Community Cloud → App settings → Secrets.
#
# Genera el secreto compartido:   python tools/hash_password.py --secret
# Genera el hash de una clave:    python tools/hash_password.py "micontraseña"

# El mismo valor debe estar en las cuatro apps (portal + los tres proyectos).
SSO_SECRET = "PEGA_AQUI_64_CARACTERES_HEX"

# URL pública del portal. Las apps enlazan aquí cuando no hay sesión válida.
PORTAL_URL = "https://teknei-movilidad.streamlit.app"

# Horas que dura el enlace de acceso. 8 = una jornada; bájalo si prefieres
# que recargar la app obligue a volver al portal.
SSO_TTL_HOURS = 8

# Salta el login en desarrollo local. Solo surte efecto si la app se sirve desde
# localhost, así que es inofensivo aunque acabe pegado en Community Cloud.
# Aun así, no lo pegues allí.
SSO_DEV_OPEN = true

# OJO al orden: en TOML una clave suelta escrita después de una cabecera [tabla]
# pasa a pertenecer a esa tabla. Las claves de arriba tienen que ir siempre
# antes del primer [users.x] / [apps.x].

# ── Usuarios ──────────────────────────────────────────────────────────────────
# projects = ["*"] da acceso a todos los proyectos.

[users.demo]
name = "Demo"
password = "scrypt$<salt_hex>$<hash_hex>"
projects = ["enkarterri"]

[users.bizkaibus]
name = "Bizkaibus"
password = "scrypt$<salt_hex>$<hash_hex>"
projects = ["*"]

# Cliente con acceso a un solo proyecto: solo ve la tarjeta de Vitoria —
# Bilbao, y el token que emite el portal solo vale para esa app.
[users.launion]
name = "La Unión"
password = "scrypt$<salt_hex>$<hash_hex>"
projects = ["vitoria"]

# ── Proyectos ─────────────────────────────────────────────────────────────────
# La clave ([apps.vitoria]) es el identificador que la app pasa a sso.require().

[apps.accessibility]
label = "Accesibilidad"
description = "Accesibilidad en transporte público a los principales destinos de Bizkaia."
url = "https://bizkaibus-accessibility.streamlit.app"

[apps.vitoria]
label = "Vitoria — Bilbao"
description = "Oferta y dimensionamiento del corredor Vitoria — Bilbao."
url = "https://vitoria-bilbao.streamlit.app"

[apps.enkarterri]
label = "Enkarterri"
description = "Impacto del escenario de transporte público en la comarca de Enkarterri."
url = "https://enkarterri.streamlit.app"
